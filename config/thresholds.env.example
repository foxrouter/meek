# rf_adapt_intel runtime configuration — copy to /etc/rf_worker/thresholds.env
# or /etc/default/rf-adapt-intel. This file is git-ignored when named
# thresholds.env (without the .example suffix).
#
# All values are passed as environment variables to the rf_adapt_intel binary.

# ---- Capture ---------------------------------------------------------------
# RF_BLOCK_LEN: samples per readStream call (default 4096).
# Larger values (e.g. 16384, 65536) reduce USB / DMA overhead but must be
# paired with an appropriate RF_ANALYSIS_LEN to preserve detection quality.
RF_BLOCK_LEN=4096

# RF_ANALYSIS_LEN: analysis window size in samples (default 4096).
# When RF_BLOCK_LEN > RF_ANALYSIS_LEN the captured block is split into
# RF_ANALYSIS_LEN-sample sub-windows; each is classified independently and
# the sub-window with the highest confidence is used for output and snapshot.
# This prevents short bursty signals from being diluted by surrounding noise
# when a large capture block is used.  Set equal to RF_BLOCK_LEN to disable
# sub-windowing (single-window path, original behaviour).
RF_ANALYSIS_LEN=4096

# RF_READ_TIMEOUT_US: SoapySDR read timeout in microseconds (default 500000)
RF_READ_TIMEOUT_US=500000

# ---- Classifier thresholds -------------------------------------------------
# RF_MIN_POWER: minimum average power to classify (default 5e-6)
RF_MIN_POWER=5e-6

# RF_CONF_THRESHOLD: minimum confidence to persist to DB (default 0.6)
RF_CONF_THRESHOLD=0.6

# RF_CONSOLE_CONF: minimum confidence for console DETECT log (default 0.8)
RF_CONSOLE_CONF=0.8

# RF_SNAPSHOT_CONF: minimum confidence to write IQ snapshot.
#   If unset (or set higher than RF_CONF_THRESHOLD), the worker automatically
#   uses RF_CONF_THRESHOLD so every DB write also produces an IQ snapshot.
#   Set explicitly only to capture snapshots at a lower confidence than the DB gate.
#RF_SNAPSHOT_CONF=0.6

# ---- SNR / BW guardrails ---------------------------------------------------
# RF_SNR_MIN_DB: SNR gate threshold in dB (default 3.0).
#   3 dB rejects noise-floor artefacts (e.g. spurious cw_like hits) while
#   passing real-world signals.  Set to 0.0 for canary / passive-only mode;
#   use ops/canary.sh to manage this safely.
RF_SNR_MIN_DB=3.0

# RF_EXPECTED_BW_HZ: expected signal bandwidth in Hz for BW guardrail.
#   0 = disabled. Set to occupied BW of target (e.g. 50000 for 50 kHz FDEV FSK).
RF_EXPECTED_BW_HZ=0

# ---- Band presets (set by process_incoming.sh per band) --------------------
# BAND: band label (e.g. 433, 868, 915, 315, 137)
# RSYM: symbol rate in sps (e.g. 128000)
# FDEV: frequency deviation in Hz (e.g. 50000)
# MOD_HINT: optional hint to bias classifier (gmsk|fsk|psk|qam|ook|cw)
# SNR_MIN: per-band SNR floor — raises the effective gate above RF_SNR_MIN_DB
#          when the band value is higher; cannot lower the global RF_SNR_MIN_DB.
# PAPR_MAX: maximum allowable PAPR in dB (0 = no limit)
#BAND=433
#RSYM=128000
#FDEV=50000
#MOD_HINT=fsk
#SNR_MIN=0.0
#PAPR_MAX=0

# ---- Paths -----------------------------------------------------------------
# RF_DB_PATH: SQLite database file (default /var/lib/rf-adapt-intel/rf_adapt_intel.db)
RF_DB_PATH=/var/lib/rf-adapt-intel/rf_adapt_intel.db

# RF_SNAPSHOT_DIR: directory for raw IQ snapshots (default /var/lib/rf-adapt-intel/snapshots)
RF_SNAPSHOT_DIR=/var/lib/rf-adapt-intel/snapshots

# RF_SNAPSHOT_RETENTION_DAYS: delete .cf32 snapshot files older than this many days.
#   0 (default) = keep all snapshots indefinitely.
#   Set to a positive integer (e.g. 7) to automatically prune old files once per day.
RF_SNAPSHOT_RETENTION_DAYS=0

# RF_WORKER_LOG: JSON log file (default /var/lib/rf-adapt-intel/worker.log)
RF_WORKER_LOG=/var/lib/rf-adapt-intel/worker.log

# RF_METRICS_FILE: Prometheus textfile path (default /var/lib/rf-adapt-intel/metrics.prom)
RF_METRICS_FILE=/var/lib/rf-adapt-intel/metrics.prom

# RF_HEARTBEAT_FILE: heartbeat file (default /var/lib/rf-adapt-intel/heartbeat)
RF_HEARTBEAT_FILE=/var/lib/rf-adapt-intel/heartbeat

# ---- Optional decoder paths ------------------------------------------------
# Populated by ops/setup.sh when optional decoders are installed.
# Leave commented out if the decoder is not installed.

# MULTIMON_NG_PATH: path to multimon-ng binary (POCSAG/FLEX/OOK decoding)
#MULTIMON_NG_PATH=/usr/bin/multimon-ng

# RTL_433_PATH: path to rtl_433 binary (OOK/ASK ISM-433 device packets)
#RTL_433_PATH=/usr/bin/rtl_433

# LIQUID_DSP_VERSION: installed liquid-dsp version (set by ops/setup.sh)
#LIQUID_DSP_VERSION=
