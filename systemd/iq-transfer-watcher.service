[Unit]
Description=IQ file transfer watcher (Ray → Brian rsync)
Documentation=https://github.com/foxrouter/meek
# Start after process-worker so the transfer watcher only runs while capture is active.
After=process-worker.service
BindsTo=process-worker.service

[Service]
Type=simple
ExecStart=/usr/bin/env bash /usr/local/share/rf-adapt-intel/scripts/transfer_iq.sh --watch
Restart=on-failure
RestartSec=10s
User=rf_worker
Group=rf_worker

WorkingDirectory=/var/lib/rf-adapt-intel
StateDirectory=rf-adapt-intel

# IQ_DEST, IQ_BW_KBPS, IQ_MAX_RETRIES — set in /etc/rf_worker/iq-transfer.env
EnvironmentFile=-/etc/rf_worker/iq-transfer.env
EnvironmentFile=-/etc/default/iq-transfer-watcher

StandardOutput=journal
StandardError=journal
SyslogIdentifier=iq-transfer-watcher

# Default hardening is in iq-transfer-watcher.service.d/hardening.conf

[Install]
# Enable alongside process-worker: systemctl enable iq-transfer-watcher
WantedBy=process-worker.service
