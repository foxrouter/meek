[Unit]
Description=Sync rf_adapt_intel.db from Ray to Brian
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rf_worker
Group=rf_worker
EnvironmentFile=-/etc/rf_worker/thresholds.env
# SSH keys are stored under /var/lib/rf-adapt-intel/.ssh (provisioned by
# deploy.sh); set HOME so rsync/ssh discover the right identity and known_hosts
# even with ProtectHome=yes active in the hardening drop-in.
Environment=HOME=/var/lib/rf-adapt-intel
TimeoutStartSec=120
ExecCondition=/usr/bin/test -n "$DB_SYNC_DEST"
ExecStart=/bin/bash -c '\
  set -euo pipefail; \
  dest="${DB_SYNC_DEST:-}"; \
  [[ -n "${dest}" ]] || exit 0; \
  ssh_opts="-o BatchMode=yes -o StrictHostKeyChecking=yes -o IdentityFile=/var/lib/rf-adapt-intel/.ssh/id_ed25519 -o UserKnownHostsFile=/var/lib/rf-adapt-intel/.ssh/known_hosts"; \
  rsync_rsh="ssh ${ssh_opts}"; \
  src_db=/var/lib/rf-adapt-intel/rf_adapt_intel.db; \
  tmp_db=$(mktemp /tmp/rf_adapt_intel.db.XXXXXX); \
  cleanup() { rm -f "${tmp_db}"; }; \
  trap cleanup EXIT; \
  /usr/bin/sqlite3 "${src_db}" ".backup ${tmp_db}"; \
  /usr/bin/touch -r "${src_db}" "${tmp_db}"; \
  chmod --reference="${src_db}" "${tmp_db}" 2>/dev/null \
    || chmod "$(stat -c "%a" "${src_db}" 2>/dev/null || echo 640)" "${tmp_db}" 2>/dev/null \
    || true; \
  remote=0; dest_host=""; dest_path="${dest}"; \
  if [[ "${dest}" =~ ^([^/@]*@)?\[([^]]*)\]:(.*)$ ]]; then \
    remote=1; dest_host="${BASH_REMATCH[1]}${BASH_REMATCH[2]}"; dest_path="${BASH_REMATCH[3]}"; \
  elif [[ "${dest}" == *:* && "${dest%%:*}" != */* ]]; then \
    remote=1; dest_host="${dest%%:*}"; dest_path="${dest#*:}"; \
  fi; \
  if (( remote )); then \
    if [[ "${dest_path}" == \~* || "${dest_path}" == *\$* ]]; then \
      echo "ERROR: DB_SYNC_DEST must not use shell expansion in the remote path; use an absolute path" >&2; \
      exit 1; \
    fi; \
    if ssh ${ssh_opts} -- "${dest_host}" sh -c "test -d \"\$1\"" _ "${dest_path}" 2>/dev/null; then \
      echo "ERROR: DB_SYNC_DEST is a remote directory; a full file path is required" >&2; \
      exit 1; \
    fi; \
    /usr/bin/rsync -az --protect-args --timeout=30 \
      -e "${rsync_rsh}" -- "${tmp_db}" "${dest}"; \
    ssh ${ssh_opts} -- "${dest_host}" sh -c "rm -f -- \"\$1\" \"\$2\"" _ \
      "${dest_path}-wal" "${dest_path}-shm"; \
  else \
    if [[ -d "${dest}" ]]; then \
      echo "ERROR: DB_SYNC_DEST is a local directory; a full file path is required" >&2; \
      exit 1; \
    fi; \
    /usr/bin/rsync -az --protect-args --timeout=30 \
      -e "${rsync_rsh}" -- "${tmp_db}" "${dest}"; \
    rm -f -- "${dest}-wal" "${dest}-shm"; \
  fi \
'
