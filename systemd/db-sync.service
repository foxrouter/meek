[Unit]
Description=Sync rf_adapt_intel.db from Ray to Brian
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rf_worker
Group=rf_worker
EnvironmentFile=-/etc/rf_worker/thresholds.env
# SSH keys are stored under /var/lib/rf-adapt-intel/.ssh (provisioned by
# deploy.sh); set HOME so rsync/ssh discover the right identity and known_hosts
# even with ProtectHome=yes active in the hardening drop-in.
Environment=HOME=/var/lib/rf-adapt-intel
TimeoutStartSec=120
ExecCondition=/usr/bin/test -n "$DB_SYNC_DEST"
ExecStart=/bin/bash -c '\
  set -euo pipefail; \
  rsync_rsh="ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o IdentityFile=/var/lib/rf-adapt-intel/.ssh/id_ed25519 -o UserKnownHostsFile=/var/lib/rf-adapt-intel/.ssh/known_hosts"; \
  src_db=/var/lib/rf-adapt-intel/rf_adapt_intel.db; \
  tmp_db=$(mktemp /tmp/rf_adapt_intel.db.XXXXXX); \
  cleanup() { rm -f "${tmp_db}"; }; \
  trap cleanup EXIT; \
  /usr/bin/sqlite3 "${src_db}" ".backup ${tmp_db}"; \
  /usr/bin/touch -r "${src_db}" "${tmp_db}"; \
  /usr/bin/rsync -az --protect-args --timeout=30 \
    -e "${rsync_rsh}" -- "${tmp_db}" "${DB_SYNC_DEST}" \
'
