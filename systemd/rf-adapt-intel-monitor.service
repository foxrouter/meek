[Unit]
Description=rf_adapt_intel canary status monitor and auto-healer (oneshot)
Documentation=https://github.com/foxrouter/meek
# Do NOT use Wants=process-worker.service here: the timer fires at boot and
# during deploy before process-worker is ready, causing a cascading start
# failure.  canary.sh --heal gracefully handles an inactive process-worker.

[Service]
Type=oneshot
# Run canary.sh --heal: prints full status then auto-recovers if the service
# is in a failed or inactive state (e.g. after hitting StartLimitBurst).
# Requires root so it can call `systemctl reset-failed` and `systemctl start`.
ExecStart=/usr/bin/env bash /usr/local/share/rf-adapt-intel/ops/canary.sh --heal
# Log to journald (no file path needed) so this unit is robust on a clean
# install where /var/lib/rf-adapt-intel may not yet exist.  Retrieve logs via:
#   journalctl -u rf-adapt-intel-monitor.service
# Requires root: canary.sh --heal needs systemctl reset-failed/start privileges.
