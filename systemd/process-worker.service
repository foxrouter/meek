[Unit]
Description=RF Process Worker (rf_adapt_intel modulation classifier)
After=network.target
Documentation=https://github.com/foxrouter/meek

[Service]
Type=simple
# ExecStart args: <center_freq_Hz> <sample_rate_Sps> <gain_dB>
# Override via ExecStart= in a drop-in (processor.conf) for different bands.
ExecStart=/usr/local/bin/rf_adapt_intel 433920000 2048000 30
WatchdogSec=30s
# Heartbeat is sent every 2 s from the main poll loop (15x safety margin).
Restart=on-failure
RestartSec=10s
StartLimitIntervalSec=120s
StartLimitBurst=5
User=rf_worker
Group=rf_worker
# Grant plugdev membership so the RTL-SDR udev rule (GROUP="plugdev") is honoured.
SupplementaryGroups=plugdev

# Runtime data directory
# StateDirectory subdirectory paths require systemd >= 235 (Bookworm ships v252)
WorkingDirectory=/var/lib/rf-adapt-intel
RuntimeDirectory=rf-adapt-intel
StateDirectory=rf-adapt-intel rf-adapt-intel/snapshots rf-adapt-intel/incoming rf-adapt-intel/processed
StateDirectoryMode=0750
LogsDirectory=rf-adapt-intel

# Load environment from drop-in override
EnvironmentFile=-/etc/rf_worker/thresholds.env
EnvironmentFile=-/etc/default/rf-adapt-intel

# Default hardening is in process-worker.service.d/hardening.conf

[Install]
WantedBy=multi-user.target
